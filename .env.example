# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Two separate Gemini keys, so the agent and everything else do not share one quota:
#   AGENT      the research agent's own LLM (proposing, tool calls, synthesis)
#   SUPPORTING vault ingest and linking, scoring (pre, post, rescore) and objectives
GEMINI_API_KEY_AGENT=
GEMINI_API_KEY_SUPPORTING=

# Optional overrides (defaults live in backend/pruner/core/config.py)
# PRUNER_FAST_MODEL=
# PRUNER_STRONG_MODEL=
# PRUNER_EMBEDDING_MODEL=
# PRUNER_AGENT_HYPOTHESIS_MODEL=
# PRUNER_AGENT_SYNTHESIS_MODEL=
# PRUNER_TOOL_CALLS_PER_PHASE=
# PRUNER_EXPERIMENT_TIMEOUT_S=
# Reuse experiment results on a re-run of the same code + command (demos): 1 to turn on
# PRUNER_EXPERIMENT_CACHE=0
# PRUNER_LLM_MIN_INTERVAL_S=
# PRUNER_SIMILARITY_THRESHOLD=0.6

# Web search for the agent and for research runs (runs without files search the vault, and the
# web when this is set). Supported: brave (Brave Search API key in SEARCH_API_KEY).
# PRUNER_SEARCH_PROVIDER=brave
# SEARCH_API_KEY=
